# OpenAI API Key (required for Outline to Tree feature)
MERMAID_OPENAI_API_KEY=your-openai-api-key-here

# Optional: Renderer URL
# MERMAID_RENDERER_URL=https://mermaid.ink

# Optional: Kroki Instance URL
# MERMAID_KROKI_RENDERER_URL=https://kroki.io

# Optional: Analytics
# MERMAID_ANALYTICS_URL=https://p.mermaid.live
# MERMAID_DOMAIN=mermaid.live

# Optional: Enable Mermaid Chart links
# MERMAID_IS_ENABLED_MERMAID_CHART_LINKS=true
